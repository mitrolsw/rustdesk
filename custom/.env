# server vars
CUSTOM_RENDEZVOUS_SERVER=screenshare.mitrol.it
CUSTOM_RELAY_SERVER=screenshare.mitrol.it
CUSTOM_API_SERVER=https://screenshare.mitrol.it
CUSTOM_PUB_KEY=co1vRo+9m47ZsXzr8jYd8bYLNQOnRntiXwU2FC29uD4=

# Application
CUSTOM_APP_NAME="Mitrol ScreenShare"
CUSTOM_APP_ID=mitrol-screenshare
CUSTOM_APP_URL="https://screenshare.mitrol.it"

# allow the one-time password to be numeric
# Y => set yes as default
CUSTOM_ALLOW_NUMERIC_ONE_TIME_PASSWORD=Y

# set the default length of temporary one-time password
# default = 6
CUSTOM_TEMPORARY_PASSWORD_LENGTH=6

# set the Adaptive view style as default
# Y => set "Adaptive" as default
CUSTOM_SET_ADAPTIVE_VIEW_STYLE=Y

# enable options enable-tcp-punch, enable-udp-punch, enable-ipv6-punch
# Y => enable them
CUSTOM_ENABLE_PUNCH=Y

# enable option enable-webrtc
# Y => enabled
CUSTOM_ENABLE_WEBRTC=Y
