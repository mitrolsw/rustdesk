RENDEZVOUS_SERVER=screenshare.mitrol.it
API_SERVER=https://screenshare.mitrol.it
RS_PUB_KEY=co1vRo+9m47ZsXzr8jYd8bYLNQOnRntiXwU2FC29uD4=

# Application name
APP_NAME="Mitrol ScreenShare"

# Application URL
CUSTOM_APP_URL="https://screenshare.mitrol.it"

# name of the generated binary (without .exe extension)
APP_BIN_NAME=mitrol-screenshare

# allow the one-time password to be numeric
CUSTOM_ALLOW_NUMERIC_ONE_TIME_PASSWORD=1

# set the default length of temporary one-time password
# accepted values: 6, 8, or 10
CUSTOM_TEMPORARY_PASSWORD_LENGTH=8

# set the Adaptive view style as default
# accepted values: 1 or 0/undefined
CUSTOM_SET_ADAPTIVE_VIEW_STYLE=1
